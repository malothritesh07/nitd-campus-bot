# Secrets — never commit. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Runtime
*.log
server.log
rag_index/
.cache/

# Source data lives outside the repo (set DATA_DIR in .env)
# ...but README screenshots must be committed
*.jsonl
rag_dataset_*.json
fee_structure.json
admission_data.json
sports_data.json
fee_pdfs/
fee_pngs/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# keep README screenshots
!docs/images/*.png
