# Secrets — never commit. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Runtime
*.log
server.log
rag_index/
.cache/

# Full scraped corpus stays out of the repo — data/sample/ is committed so a
# clone can run, and is negated below.
*.jsonl
rag_dataset_*.json
fee_structure.json
admission_data.json
sports_data.json
fee_pdfs/
fee_pngs/
!data/sample/**

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# keep README screenshots
!docs/images/*.png
