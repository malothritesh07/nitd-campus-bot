# Streamlit Cloud: paste this into Settings -> Secrets (do NOT commit real values).
# Locally, streamlit_app.py falls back to .env, so this file is optional.

MONGO_URI = "mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0"
DB_NAME   = "nitd_campus"

# Set ONCE before issuing any shop-owner codes — changing it invalidates them all.
SERVER_PEPPER = "generate-a-long-random-string"

# Leave this OUT of a public demo — visitors supply their own key in the sidebar,
# so the deployment carries no cost and no exposed credential. Without any key
# the bot still answers everything; Syllabus answers come back as source text
# rather than phrased prose, and the badge says so.
# GROQ_API_KEY = ""

# Dense retrieval needs ~460 MB of RSS on top of the ~120 MB baseline.
# Streamlit Community Cloud allows ~1 GB, so leave this on. Set to 0 on a
# 512 MB host and prose retrieval falls back to BM25 alone.
ENABLE_DENSE = "1"

# Do NOT set EMBED_OFFLINE on Streamlit Cloud — the model is not cached there
# and must download on first boot.

LANGSMITH_TRACING = "false"
