# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- MongoDB Atlas ----
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=Cluster0
DB_NAME=nitd_campus

# ---- Shop-status auth ----
# Key used to derive the indexable lookup for owner codes. Set this ONCE before
# issuing any codes: changing it later invalidates every code already handed out.
SERVER_PEPPER=generate-a-long-random-string
AUTO_CLOSE_HOUR=23
STALE_HOURS=6

# ---- LLM ----
# Only the Syllabus category calls this. Every other category is template-rendered
# from MongoDB and keeps working if the key is missing or out of quota.
GROQ_API_KEY=

# ---- Embeddings ----
# Computed on the machine running the app, never sent to a third party.
EMBED_MODEL=all-MiniLM-L6-v2

# Folder holding the source JSON/JSONL files that `sync.py` ingests.
DATA_DIR=./data

# ---- Tracing (optional) ----
# Set LANGSMITH_TRACING=false to disable without removing the key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nitd-campus-bot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# How long the app caches the `config` collection before re-reading it.
CONFIG_RELOAD_SECONDS=60
EMBED_OFFLINE=
# Set to 1 only if the model is already cached and the machine is offline.

# ---- Cache + rate limiting backend (optional) ----
# Set REDIS_URL for atomic counters and sub-ms cache reads. Leave blank and both
# use MongoDB TTL collections — no extra service to run.
REDIS_URL=
